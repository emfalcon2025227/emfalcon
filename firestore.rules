rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc() && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "GUEST";
    }

    function getUserOwnerId() {
      return hasUserDoc() && 'ownerId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId
        : "";
    }

    function getUserTenantId() {
      return hasUserDoc() && 'tenantId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId
        : "";
    }

    function isStaff() {
      return isSignedIn() && (
        getUserRole() == "SYSTEM_OWNER" ||
        getUserRole() == "ADMIN" ||
        getUserRole() == "SUPER_ADMIN" ||
        getUserRole() == "MANAGER" ||
        getUserRole() == "FINANCE" ||
        getUserRole() == "LEGAL" ||
        getUserRole() == "PROPERTY_MANAGER" ||
        getUserRole() == "DATA_ENTRY" ||
        getUserRole() == "SALES_MANAGER"
      );
    }

    function isOwner() {
      return isSignedIn() && (getUserRole() == "OWNER" || getUserRole() == "PROPERTY_OWNER");
    }

    function isTenant() {
      return isSignedIn() && getUserRole() == "TENANT";
    }

    function isSystemOwner() {
      return isSignedIn() && getUserRole() == "SYSTEM_OWNER";
    }

    function isAdminOrSystemOwner() {
      return isSignedIn() && (
        getUserRole() == "SYSTEM_OWNER" ||
        getUserRole() == "ADMIN" ||
        getUserRole() == "SUPER_ADMIN"
      );
    }

    // --- Users & Profiles Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      // CREATE: Staff/Admin can create user profiles (only System Owner can create SYSTEM_OWNER).
      // Self-creation is restricted to initial bootstrap or non-privileged roles.
      allow create: if (
        isSystemOwner() ||
        (isAdminOrSystemOwner() && request.resource.data.role != "SYSTEM_OWNER") ||
        (isStaff() && request.resource.data.role != "SYSTEM_OWNER" && request.resource.data.role != "ADMIN" && request.resource.data.role != "SUPER_ADMIN") ||
        (isSignedIn() && request.auth.uid == userId && (
          !('role' in request.resource.data) || 
          request.resource.data.role == "GUEST" || 
          request.resource.data.role == "TENANT" || 
          request.resource.data.role == "OWNER"
        ))
      );

      // UPDATE: System Owner has full control. Admin can update non-SYSTEM_OWNER profiles.
      // Self-updates by ordinary users CANNOT modify sensitive authorization fields (role, ownerId, tenantId, permissions, isActive, firebaseUid).
      allow update: if (
        isSystemOwner() ||
        (isAdminOrSystemOwner() && resource.data.role != "SYSTEM_OWNER" && request.resource.data.role != "SYSTEM_OWNER") ||
        (isSignedIn() && request.auth.uid == userId && (
          // Identity & authorization fields must remain strictly immutable in self-service updates
          request.resource.data.role == resource.data.role &&
          (!('ownerId' in resource.data) || request.resource.data.ownerId == resource.data.ownerId) &&
          (!('tenantId' in resource.data) || request.resource.data.tenantId == resource.data.tenantId) &&
          (!('isActive' in resource.data) || request.resource.data.isActive == resource.data.isActive) &&
          (!('firebaseUid' in resource.data) || request.resource.data.firebaseUid == resource.data.firebaseUid) &&
          (!('permissions' in resource.data) || request.resource.data.permissions == resource.data.permissions)
        ))
      );

      // DELETE: Only System Owner can delete users, or Admins deleting non-SYSTEM_OWNER records.
      allow delete: if isSystemOwner() || (isAdminOrSystemOwner() && resource.data.role != "SYSTEM_OWNER");
    }

    match /users_by_email/{docId} {
      allow read: if isStaff() || (isSignedIn() && (docId == request.auth.token.email || (hasUserDoc() && 'email' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == docId)));
      allow write: if isStaff();
    }

    match /userPermissionOverrides/{docId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdminOrSystemOwner();
    }

    // --- Core Master Data ---
    match /properties/{propertyId} {
      allow read: if isStaff() || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }
    match /units/{unitId} {
      allow read: if isStaff() || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }
    match /owners/{ownerId} {
      allow read: if isStaff() || (isOwner() && getUserOwnerId() == ownerId);
      allow write: if isStaff();
    }
    match /tenants/{tenantId} {
      allow read: if isStaff() || (isTenant() && getUserTenantId() == tenantId) || isOwner();
      allow write: if isStaff();
    }

    // --- Leases & Renewals ---
    match /leases/{leaseId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId()) || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }
    match /lease_renewals/{renewalId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId()) || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }

    // --- Cheques & Collections ---
    match /cheques/{chequeId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId()) || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }
    match /returned_cheques/{chequeId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId()) || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }
    match /collections/{collectionId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId()) || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }

    // --- Expenses & Transfers ---
    match /property_expenses/{expenseId} {
      allow read: if isStaff() || (isOwner() && resource.data.ownerId == getUserOwnerId()) || (isTenant() && resource.data.tenantId == getUserTenantId() && resource.data.costBearer == "TENANT");
      allow write: if isStaff();
    }
    match /owner_transfers/{transferId} {
      allow read: if isStaff() || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }

    // --- Financial Ledger & Reversals & Adjustments ---
    match /journal_entries/{entryId} {
      allow read, write: if isStaff();
    }
    match /journal_event_keys/{keyId} {
      allow read, write: if isStaff();
    }
    match /financial_reversals/{docId} {
      allow read, write: if isStaff();
    }
    match /financial_adjustments/{docId} {
      allow read, write: if isStaff();
    }
    match /chart_of_accounts/{docId} {
      allow read, write: if isStaff();
    }
    match /commissions/{commissionId} {
      allow read: if isStaff() || (isOwner() && resource.data.ownerId == getUserOwnerId()) || (isTenant() && resource.data.tenantId == getUserTenantId());
      allow write: if isStaff();
    }
    match /payment_allocations/{allocationId} {
      allow read: if isStaff() || (isOwner() && resource.data.ownerId == getUserOwnerId()) || (isTenant() && resource.data.tenantId == getUserTenantId());
      allow write: if isStaff();
    }
    match /payment_promises/{docId} {
      allow read, write: if isStaff();
    }
    match /deferred_payments/{docId} {
      allow read, write: if isStaff();
    }
    match /collection_actions/{docId} {
      allow read, write: if isStaff();
    }

    // --- Petty Cash ---
    match /office_petty_cash_months/{docId} {
      allow read, write: if isStaff();
    }
    match /office_petty_cash_expenses/{docId} {
      allow read, write: if isStaff();
    }
    match /office_petty_cash_categories/{docId} {
      allow read, write: if isStaff();
    }

    // --- Deposits & Financial Periods ---
    match /daily_deposits/{depositId} {
      allow read, write: if isStaff();
    }
    match /deposit_batches/{depositId} {
      allow read, write: if isStaff();
    }
    match /financial_periods/{periodId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /period_certifications/{periodId} {
      allow read, write: if isStaff();
    }

    // --- Maintenance, Technicians, Cases, Notifications, Archive, Audit Logs, History ---
    match /maintenance_requests/{requestId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId()) || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff() || isTenant();
    }
    match /technicians/{techId} {
      allow read, write: if isStaff();
    }
    match /cases/{docId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId());
      allow write: if isStaff();
    }
    match /notifications/{docId} {
      allow read: if isStaff() || (isTenant() && resource.data.tenantId == getUserTenantId()) || (isOwner() && resource.data.ownerId == getUserOwnerId());
      allow write: if isStaff();
    }
    match /archive/{docId} {
      allow read, write: if isStaff();
    }
    match /electronic_archive/{docId} {
      allow read, write: if isStaff();
    }
    match /auditLogs/{docId} {
      allow read, write: if isStaff();
    }
    match /audit_logs/{docId} {
      allow read, write: if isStaff();
    }
    match /historicalRecords/{docId} {
      allow read, write: if isStaff();
    }
    match /historical_records/{docId} {
      allow read, write: if isStaff();
    }

    // --- System Settings, Configurations & Settings ---
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /form_layouts/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /company_profile/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /system_counters/{docId} {
      allow read, write: if isStaff();
    }
    match /system_backups/{docId} {
      allow read, write: if isStaff();
    }
    match /risk_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /vatRates/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /vat_rates/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /operational_communications/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
    match /_system_health/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
